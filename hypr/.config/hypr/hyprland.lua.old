-- Hyprland Lua configuration generator
-- Run with: lua ~/.config/hypr/hyprland.lua
-- It writes ~/.config/hypr/hyprland.conf.
--
-- Lua does not configure Hyprland directly: this script generates the native
-- Hyprland config, which Hyprland then loads as usual.

local HOME = os.getenv("HOME") or ""
local CONFIG_DIR = HOME .. "/.config/hypr"
local OUTPUT = CONFIG_DIR .. "/hyprland.conf"

local lines = {}

local function add(line)
    lines[#lines + 1] = line
end

local function setting(key, value)
    add(("    %s = %s"):format(key, tostring(value)))
end

local function block(name, settings, children)
    add("")
    add(name .. " {")
    for _, item in ipairs(settings or {}) do
        setting(item[1], item[2])
    end
    if children then
        for _, child in ipairs(children) do
            add("")
            add("    " .. child.name .. " {")
            for _, item in ipairs(child.settings) do
                setting(item[1], item[2])
            end
            add("    }")
        end
    end
    add("}")
end

local function bind(modifiers, key, dispatcher, argument, comment)
    local lhs = modifiers or ""
    local line = ("bind = %s, %s, %s"):format(lhs, key, dispatcher)
    if argument and argument ~= "" then
        line = line .. ", " .. argument
    end
    if comment then
        line = line .. "  # " .. comment
    end
    add(line)
end

local function bindm(modifiers, key, dispatcher)
    add(("bindm = %s, %s, %s"):format(modifiers, key, dispatcher))
end

-- Monitor
add("# Generated by hyprland.lua — edit the Lua file, not this output.")
add("# Monitor")
add("monitor = eDP-1,preferred,auto,1")

-- Startup and environment
add("")
add("# Startup applications")
local startup = {
    "swayosd-server",
    "kdeconnectd",
    CONFIG_DIR .. "/xdg-portal-hyprland",
    "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP",
    "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP",
    "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1",
    "waybar & hypridle",
}
for _, command in ipairs(startup) do
    add("exec-once = " .. command)
end
add("exec = swaybg -m fill -i " .. CONFIG_DIR .. "/hong-kong-night.jpg")
add("env = QT_QPA_PLATFORMTHEME,qt5ct")

-- Input
block("input", {
    {"kb_layout", "us,rs"},
    {"kb_variant", ",latin"},
    {"kb_model", ""},
    {"kb_rules", ""},
    {"kb_options", "grp:alt_shift_toggle"},
    {"follow_mouse", 1},
    {"sensitivity", 0},
}, {
    {
        name = "touchpad",
        settings = {
            {"natural_scroll", "no"},
            {"disable_while_typing", "false"},
            {"clickfinger_behavior", "true"},
        },
    },
})

-- General appearance/layout
block("general", {
    {"gaps_in", 5},
    {"gaps_out", 20},
    {"border_size", 2},
    {"col.active_border", "rgb(cdd6f4)"},
    {"col.inactive_border", "rgba(595959aa)"},
    {"layout", "dwindle"},
})

block("misc", {
    {"disable_hyprland_logo", "yes"},
})

block("decoration", {
    {"rounding", 10},
}, {
    {
        name = "blur",
        settings = {
            {"enabled", "true"},
            {"size", 1},
            {"passes", 2},
        },
    },
})

-- Animations
block("animations", {
    {"enabled", "yes"},
    {"bezier", "myBezier, 0.05, 0.9, 0.1, 1.05"},
    {"animation", "windows, 1, 7, myBezier"},
    {"animation", "windowsOut, 1, 7, default, popin 80%"},
    {"animation", "border, 1, 10, default"},
    {"animation", "fade, 1, 7, default"},
    {"animation", "workspaces, 1, 6, default"},
})

block("dwindle", {
    {"preserve_split", "yes"},
})

-- Empty blocks are omitted because they have no effect.
add("")
add("# Window manager settings")
add("$mainMod = SUPER")

-- Main keybindings
add("")
add("# Main keybindings")
bind("$mainMod", "Q", "exec", "kitty", "Open terminal")
bind("$mainMod SHIFT", "X", "killactive", "", "Close active window")
bind("$mainMod", "L", "exec", "hyprlock", "Lock screen")
bind("$mainMod", "M", "exec", "wlogout --protocol layer-shell", "Logout menu")
bind("$mainMod SHIFT", "M", "exit", "", "Exit Hyprland")
bind("$mainMod", "E", "exec", "dolphin", "File manager")
bind("$mainMod", "V", "togglefloating", "", "Toggle floating")
bind("$mainMod", "A", "exec", "rofi -show drun", "Application launcher")
bind("$mainMod", "P", "pseudo", "", "Dwindle pseudotile")
bind("$mainMod", "S", "exec", "hyprshot -m output -o " .. HOME .. "/Pictures/Screenshots -c", "Screenshot output")
bind("$mainMod", "B", "exec", "firefox", "Firefox")
bind("$mainMod", "W", "exec", "pkill waybar || waybar", "Toggle Waybar")

-- Multimedia / laptop-specific keybindings retained from the original config
add("")
add("# Multimedia and laptop-specific keys")
bind("", "XF86AudioMute", "exec", "swayosd-client --output-volume mute-toggle")
bind("", "122", "exec", "swayosd-client --output-volume lower")
bind("", "123", "exec", "swayosd-client --output-volume raise")
bind("", "256", "exec", "pamixer --default-source -t", "Microphone mute")
bind("", "232", "exec", "swayosd-client --brightness lower")
bind("", "233", "exec", "swayosd-client --brightness raise")
bind("", "210", "exec", "asusctl led-mode -n", "Keyboard RGB profile")

-- Focus movement
add("")
add("# Move focus")
bind("$mainMod", "left", "movefocus", "l")
bind("$mainMod", "right", "movefocus", "r")
bind("$mainMod", "up", "movefocus", "u")
bind("$mainMod", "down", "movefocus", "d")

-- Workspaces
add("")
add("# Switch workspaces")
for n = 1, 9 do
    bind("$mainMod", tostring(n), "workspace", tostring(n))
end
bind("$mainMod", "0", "workspace", "10")

add("")
add("# Move active window to a workspace")
for n = 1, 9 do
    bind("$mainMod SHIFT", tostring(n), "movetoworkspace", tostring(n))
end
bind("$mainMod SHIFT", "0", "movetoworkspace", "10")

-- Workspace scrolling and mouse window actions
add("")
add("# Workspace scrolling")
bind("$mainMod", "mouse_down", "workspace", "e+1")
bind("$mainMod", "mouse_up", "workspace", "e-1")

add("")
add("# Move/resize windows with mainMod + mouse")
bindm("$mainMod", "mouse:272", "movewindow")
bindm("$mainMod", "mouse:273", "resizewindow")

-- Media controls
add("")
add("# Media controls")
bind("$mainMod ALT", "SPACE", "exec", "playerctl play-pause")
bind("$mainMod ALT", "N", "exec", "playerctl next")
bind("$mainMod ALT", "P", "exec", "playerctl previous")
bind("", "XF86AudioStop", "exec", "playerctl stop")
bind("$mainMod", "Print", "exec", "hyprshot -m active -o " .. HOME .. "/Pictures/Screenshots -z --clipboard-only")

-- Write generated configuration
local file, err = io.open(OUTPUT, "w")
if not file then
    io.stderr:write(("Could not write %s: %s\n"):format(OUTPUT, err or "unknown error"))
    os.exit(1)
end

file:write(table.concat(lines, "\n"), "\n")
file:close()

print("Generated " .. OUTPUT)
print("Reload Hyprland with: hyprctl reload")

