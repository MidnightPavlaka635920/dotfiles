#!/usr/bin/python3

import json
import math
import os.path
import re
import statistics
import subprocess
import sys
import time
import yaml
print(json.dumps({
        'text': "         "}), flush=True)
history = []
history_len = 10
for i in range(0, history_len):
    history.append(0)

# ARGUMENTS

scriptpath = sys.argv.pop(0)

# 1. Interval - default 1
t = 1
if len(sys.argv) > 0:
    t = float(sys.argv.pop(0))

# 2. Number of timings to measure and average over - default 1
max_times = 3
if len(sys.argv) > 0:
    max_times = int(sys.argv.pop(0))

# 3. Shading mode - default off, 'on' to enable
colour_bars = 'off'
if len(sys.argv) > 0:
    colour_bars = sys.argv.pop(0)


# Tooltips will update every this many seconds
tooltip_update_time = 1


# Appearance

chars = ' ▁▂▃▄▅▆▇█'

states = {}
config_file = os.path.abspath(os.path.dirname(scriptpath)) + "/cpu_graphical.yml"
if os.path.exists(config_file):
    with open(config_file, 'r') as fh:
        config = yaml.load(fh, Loader=yaml.CLoader)
        for state in config['states']:
            states[config['states'][state]['threshold']] = {
                'status': state,
                'background': config['states'][state]['background'],
                'foreground': config['states'][state]['foreground'],
            }
else:
    raise Exception("No such config file: {}".format(config_file))

state_keys = sorted(list(states.keys()), reverse=True)


def show_bar(perc, status):
    bar = math.ceil(perc / (100 / (len(chars) - 1)))
    char = chars[bar]

    if colour_bars == 'on':
        colour = colour_mix(status['background'], status['foreground'], perc / 100)
        return "<span foreground='{1}'>{0}</span>".format(char, colour)
    else:
        return char

def call(command):
    result = subprocess.run(command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return result.stdout.decode('utf-8').rstrip("\n")

def cpu_times():
    cpus = []

    with open('/proc/stat') as f:
        for line in f:
            if not re.match(r'^cpu\d+\s', line):
                if cpus:
                    break
                continue

            fields = list(map(int, line.split()[1:]))

            # user, nice, system, idle, iowait,
            # irq, softirq, steal
            busy = sum(fields[:3]) + sum(fields[5:8])

            cpus.append(busy)

    return cpus
def colour_parse(colour):
    c1 = int(colour[1:3], base=16)
    c2 = int(colour[3:5], base=16)
    c3 = int(colour[5:7], base=16)
    return [c1, c2, c3]

def colour_mix(colour1, colour2, mix):
    colour1 = colour_parse(colour1)
    colour2 = colour_parse(colour2)
    new_colour = []
    for i, c1 in enumerate(colour1):
        c2 = colour2[i]
        new_colour.append(c1 * (1 - mix) + c2 * mix)
    return colour_hex(new_colour)

def colour_hex(colour):
    return '#' + ''.join(["{:02x}".format(int(c)) for c in colour])


clock_ticks_per_second = float(call('getconf CLK_TCK'))

last_time = time.perf_counter()
cpu_timings = [(last_time, cpu_times())]
number_of_cpus = len(cpu_timings[0][1])

tooltip = ''
tooltip_time = 0
tooltip_max_times = max(round(1 / t), 1)

while True:
    now = time.perf_counter()
    delta_t = now - last_time

    time.sleep(max(t - delta_t, 0))

    now = time.perf_counter()
    delta_t = now - last_time
    last_time = now

    cpu_timings.append((now, cpu_times()))

    while len(cpu_timings) > max(max_times, tooltip_max_times) + 1:
        cpu_timings.pop(0)

    def calculate_usage(samples):
        start_time, start_cpus = samples[0]
        end_time, end_cpus = samples[-1]

        elapsed = end_time - start_time

        if elapsed <= 0:
            return [0] * len(end_cpus)

        return [
            max(0, min(round(
                (end_cpus[i] - start_cpus[i])
                / clock_ticks_per_second
                / elapsed * 100
            ), 100))
            for i in range(len(end_cpus))
        ]
    cpus = calculate_usage(
        cpu_timings[-(max_times + 1):]
    )

    tooltip_cpus = calculate_usage(
        cpu_timings[-(tooltip_max_times + 1):]
    )

    average = statistics.mean(cpus)
    # Status calculated from average usage
    status = None
    for status_level in state_keys:
        if average >= status_level:
            status = states[status_level]
            break

    # Make bar graphical output
    #bars = ''.join([show_bar(c, status) for c in cpus])
    history.append(average)
    history = history[-history_len:]

    bars = ''.join([show_bar(v, status) for v in history])

    # Tooltip text - right aligned
    tooltip_time += delta_t
    if tooltip_time >= tooltip_update_time:
        tooltip_time = 0
        max_width = max([len("{}".format(c)) for c in tooltip_cpus])
        tooltip_format = '{:' + str(max_width) + '}%'
        tooltip = "\n".join([tooltip_format.format(c) for c in tooltip_cpus])

    # Output JSON row
    print(json.dumps({
        'text': bars,
        'class': status['status'],
        'percentage': int(average),
        'tooltip': tooltip
        }), flush=True)
